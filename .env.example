# Copy to .env (untracked) and fill in locally. Never commit .env.
KITCHENOWL_URL=
KITCHENOWL_TOKEN=
KITCHENOWL_HOUSEHOLD_ID=
KITCHENOWL_LIST_ID=
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Optional; defaults to data/hga.db (relative to the working directory).
HGA_DB_PATH=
# Optional price comparison settings (defaults: 29401, 15, 30, 3; see docs/prices.md).
HGA_PRICE_ZIP=
HGA_PRICE_RADIUS_MILES=
HGA_PRICE_MAX_AGE_DAYS=
HGA_PRICE_MIN_INTERVAL_SECONDS=
